# ==============================================================================
# ShopCloud — Docker Compose Environment Variables
# Copy to .env or pass directly to docker compose:
#   docker compose --env-file .env.docker.example up -d
# NOTE: Never commit sensitive production credentials or secrets.
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000
API_PORT=3000
WEB_PORT=80
WORKERS_PORT=8081

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=shopcloud
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgrespassword@postgres:5432/shopcloud?schema=public"

# Authentication & JWT Configuration
JWT_ACCESS_SECRET="shopcloud-dev-jwt-access-secret-replace-in-secret-manager"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="shopcloud-dev-jwt-refresh-secret-replace-in-secret-manager"
JWT_REFRESH_EXPIRES_IN="7d"
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# CORS & URLs
# Comma-separated allowlist; "*" is rejected when NODE_ENV=production
CORS_ORIGIN="http://localhost,http://localhost:80,http://localhost:5173"
# X-Forwarded-For entries appended by trusted proxies (nginx in Compose, Google front end on Cloud Run)
TRUST_PROXY_HOPS=1
API_URL="http://api:3000"

# GCP Emulators & Project Context
GCP_PROJECT_ID="shopcloud-dev"
GCP_REGION="asia-south1"
PUBSUB_EMULATOR_HOST="pubsub:8085"
