# ==============================================================================
# ShopCloud Event Consumer Workers Daemon — Multi-stage Production Dockerfile
# Base: Node.js 22 LTS on Debian Bookworm Slim
# Target Runtime: Google Cloud Run & Local Docker Compose
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Dependency Installation & Layer Caching
# ------------------------------------------------------------------------------
FROM node:22-bookworm-slim AS dependencies

WORKDIR /app

# Install OpenSSL and CA certificates for Prisma and Pub/Sub TLS connectivity
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy root and workspace package manifests
COPY package*.json ./
COPY packages/contracts/package*.json ./packages/contracts/
COPY packages/database/package*.json ./packages/database/
COPY apps/workers/package*.json ./apps/workers/

# Deterministic clean dependency install
RUN npm ci

# ------------------------------------------------------------------------------
# Stage 2: Application Build
# ------------------------------------------------------------------------------
FROM dependencies AS builder

WORKDIR /app

# Copy source code across workspaces
COPY packages/contracts ./packages/contracts
COPY packages/database ./packages/database
COPY apps/workers ./apps/workers

# Build shared contracts
RUN npm run build --workspace=@shopcloud/contracts

# Generate Prisma Client binary engine
RUN npx prisma generate --schema=./packages/database/prisma/schema.prisma

# Build shared database package (dist/ is consumed by the workers and copied into the runtime stage)
RUN npm run build --workspace=@shopcloud/database

# Build TypeScript Workers Daemon
RUN npm run build --workspace=@shopcloud/workers

# Prune development dependencies for minimal production footprint
RUN npm prune --omit=dev

# ------------------------------------------------------------------------------
# Stage 3: Minimal Production Runtime
# ------------------------------------------------------------------------------
FROM node:22-bookworm-slim AS runner

WORKDIR /app

# Install runtime OpenSSL and CA certificates for Prisma and Pub/Sub
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV HEALTH_PORT=8081

# Security: Run as unprivileged non-root user (UID 1000)
USER node

# Copy production artifacts and minimal hoisted node_modules
COPY --chown=node:node --from=builder /app/package*.json ./
COPY --chown=node:node --from=builder /app/node_modules ./node_modules
COPY --chown=node:node --from=builder /app/packages/contracts/dist ./packages/contracts/dist
COPY --chown=node:node --from=builder /app/packages/contracts/package.json ./packages/contracts/
COPY --chown=node:node --from=builder /app/packages/database/dist ./packages/database/dist
COPY --chown=node:node --from=builder /app/packages/database/prisma ./packages/database/prisma
COPY --chown=node:node --from=builder /app/packages/database/package.json ./packages/database/
COPY --chown=node:node --from=builder /app/apps/workers/dist ./apps/workers/dist
COPY --chown=node:node --from=builder /app/apps/workers/package.json ./apps/workers/

EXPOSE 8081

# Built-in zero-dependency HTTP health probe
HEALTHCHECK --interval=20s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "const http = require('http'); const req = http.request({ host: '127.0.0.1', port: process.env.HEALTH_PORT || 8081, path: '/health', timeout: 3000 }, (res) => { process.exit(res.statusCode === 200 ? 0 : 1); }); req.on('error', () => process.exit(1)); req.end();"

CMD ["node", "apps/workers/dist/index.js"]
