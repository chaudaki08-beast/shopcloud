# ==============================================================================
# ShopCloud Customer Storefront & Admin Portal — Multi-stage Production Dockerfile
# Stage 1: Build Vite React App via Node.js 22 LTS
# Stage 2: Serve compiled static assets via Nginx Alpine
# Target Runtime: Google Cloud Run & Local Docker Compose
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Dependency Installation & Application Build
# ------------------------------------------------------------------------------
FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Copy root and workspace package manifests
COPY package*.json ./
COPY packages/contracts/package*.json ./packages/contracts/
COPY apps/web/package*.json ./apps/web/

# Deterministic clean dependency install
RUN npm ci

# Copy source code across workspaces
COPY packages/contracts ./packages/contracts
COPY apps/web ./apps/web

# Build shared contracts
RUN npm run build --workspace=@shopcloud/contracts

# Build production Vite bundle (dist/)
RUN npm run build --workspace=@shopcloud/web

# ------------------------------------------------------------------------------
# Stage 2: Minimal Web Server Runtime (Nginx Alpine)
# ------------------------------------------------------------------------------
FROM nginx:alpine AS runner

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled static assets from builder
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# nginx config template, rendered at startup by the image entrypoint (envsubst) into conf.d/default.conf
COPY apps/web/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --chmod=755 apps/web/docker/15-resolver.envsh /docker-entrypoint.d/15-resolver.envsh

# Defaults for Docker Compose; Cloud Run overrides PORT, and API_UPSTREAM is set per environment
ENV PORT=80
ENV API_UPSTREAM=http://api:3000

EXPOSE 80

# Health probe checking dedicated /health location on the configured port
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q -O - "http://127.0.0.1:${PORT}/health" || exit 1

CMD ["nginx", "-g", "daemon off;"]
