# ==============================================================================
# ShopCloud Customer Storefront & Admin Portal — Multi-stage Production Dockerfile
# Stage 1: Build Vite React App via Node.js 22 LTS
# Stage 2: Serve compiled static assets via Nginx Alpine
# Target Runtime: Google Cloud Run & Local Docker Compose
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Dependency Installation & Application Build
# ------------------------------------------------------------------------------
FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Copy root and workspace package manifests
COPY package*.json ./
COPY packages/contracts/package*.json ./packages/contracts/
COPY apps/web/package*.json ./apps/web/

# Deterministic clean dependency install
RUN npm ci

# Copy source code across workspaces
COPY packages/contracts ./packages/contracts
COPY apps/web ./apps/web

# Build shared contracts
RUN npm run build --workspace=@shopcloud/contracts

# Build production Vite bundle (dist/)
RUN npm run build --workspace=@shopcloud/web

# ------------------------------------------------------------------------------
# Stage 2: Minimal Web Server Runtime (Nginx Alpine)
# ------------------------------------------------------------------------------
FROM nginx:alpine AS runner

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled static assets from builder
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Copy custom production nginx configuration
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Health probe checking dedicated /health location
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q -O - http://127.0.0.1:80/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
