# ==============================================================================
# ShopCloud API Gateway — Multi-stage Production Dockerfile
# Base: Node.js 22 LTS on Debian Bookworm Slim
# Target Runtime: Google Cloud Run & Local Docker Compose
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Dependency Installation & Layer Caching
# ------------------------------------------------------------------------------
FROM node:22-bookworm-slim AS dependencies

WORKDIR /app

# Install OpenSSL and CA certificates for Prisma engine compatibility
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy root and workspace package manifests
COPY package*.json ./
COPY packages/contracts/package*.json ./packages/contracts/
COPY packages/database/package*.json ./packages/database/
COPY apps/api/package*.json ./apps/api/

# Deterministic clean dependency install
RUN npm ci

# ------------------------------------------------------------------------------
# Stage 2: Application Build
# ------------------------------------------------------------------------------
FROM dependencies AS builder

WORKDIR /app

# Copy source code across workspaces
COPY packages/contracts ./packages/contracts
COPY packages/database ./packages/database
COPY apps/api ./apps/api

# Build shared contracts
RUN npm run build --workspace=@shopcloud/contracts

# Generate Prisma Client binary engine
RUN npx prisma generate --schema=./packages/database/prisma/schema.prisma

# Build NestJS API Gateway
RUN npm run build --workspace=@shopcloud/api

# Prune development dependencies for minimal production footprint
RUN npm prune --omit=dev

# ------------------------------------------------------------------------------
# Stage 3: Minimal Production Runtime
# ------------------------------------------------------------------------------
FROM node:22-bookworm-slim AS runner

WORKDIR /app

# Install runtime OpenSSL and CA certificates for Prisma and HTTPS calls
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV PORT=3000

# Security: Run as unprivileged non-root user (UID 1000)
USER node

# Copy production artifacts and minimal hoisted node_modules
COPY --chown=node:node --from=builder /app/package*.json ./
COPY --chown=node:node --from=builder /app/node_modules ./node_modules
COPY --chown=node:node --from=builder /app/packages/contracts/dist ./packages/contracts/dist
COPY --chown=node:node --from=builder /app/packages/contracts/package.json ./packages/contracts/
COPY --chown=node:node --from=builder /app/packages/database/dist ./packages/database/dist
COPY --chown=node:node --from=builder /app/packages/database/prisma ./packages/database/prisma
COPY --chown=node:node --from=builder /app/packages/database/package.json ./packages/database/
COPY --chown=node:node --from=builder /app/apps/api/dist ./apps/api/dist
COPY --chown=node:node --from=builder /app/apps/api/package.json ./apps/api/

EXPOSE 3000

# Built-in zero-dependency health check probe
HEALTHCHECK --interval=20s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "const http = require('http'); const req = http.request({ host: '127.0.0.1', port: process.env.PORT || 3000, path: '/api/v1/health/liveness', timeout: 3000 }, (res) => { process.exit(res.statusCode === 200 ? 0 : 1); }); req.on('error', () => process.exit(1)); req.end();"

CMD ["node", "apps/api/dist/main.js"]
