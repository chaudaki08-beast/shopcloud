#!/bin/sh
# Sourced by the nginx image entrypoint before template rendering: expose the container's DNS server
# (Docker's 127.0.0.11 in Compose, the metadata server on Cloud Run) to nginx.conf.template.
if [ -z "${NGINX_RESOLVER:-}" ]; then
  NGINX_RESOLVER=$(awk '/^nameserver/ { print $2; exit }' /etc/resolv.conf)
  case "$NGINX_RESOLVER" in
    *:*) NGINX_RESOLVER="[$NGINX_RESOLVER]" ;;
  esac
  export NGINX_RESOLVER
fi
