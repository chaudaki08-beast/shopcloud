# Rendered at container start by the nginx image's envsubst (/etc/nginx/templates -> conf.d).
# Only defined environment variables are substituted: PORT, API_UPSTREAM, NGINX_RESOLVER.
# nginx runtime variables such as $host are left untouched.
server {
    # Cloud Run injects PORT (8080); the image defaults it to 80 for Docker Compose
    listen ${PORT};
    server_name _;

    # DNS resolver from the container's /etc/resolv.conf (see 15-resolver.envsh). Resolving the upstream per
    # request means nginx starts even when the API is not resolvable yet and never pins a stale Cloud Run IP.
    resolver ${NGINX_RESOLVER} valid=30s ipv6=off;

    root /usr/share/nginx/html;
    index index.html;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # Health Probe endpoint
    location = /health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"UP","service":"shopcloud-web"}\n';
    }

    # Static asset caching
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # Reverse proxy to NestJS API: http://api:3000 in Compose, https://<api-service>.run.app on Cloud Run
    location /api/ {
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        # Cloud Run routes by Host, so send the upstream's host (and SNI for https)
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_ssl_server_name on;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # SPA Client-Side Routing fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
