# Environment
NODE_ENV=development
PORT=3000

# Database (Cloud SQL / Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopcloud?schema=public"

# Auth / JWT
JWT_SECRET="shopcloud-production-jwt-secret-replace-in-secret-manager"
JWT_EXPIRES_IN="7d"

# GCP Project & Infrastructure
GCP_PROJECT_ID="shopcloud-dev"
GCP_REGION="asia-south1"
GCS_MEDIA_BUCKET="shopcloud-dev-media"
PUBSUB_EMULATOR_HOST="localhost:8085"

# Workers & Pub/Sub
PUBSUB_ORDER_TOPIC="order-created"
PUBSUB_PAYMENT_TOPIC="payment-completed"
PUBSUB_INVENTORY_TOPIC="inventory-updated"
PUBSUB_NOTIFICATION_TOPIC="notification-requested"

# Payment Sandbox Provider
STRIPE_SECRET_KEY="sk_test_mock_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_mock_stripe_webhook"
