{
  "name": "shopcloud",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Style, Event-Driven E-Commerce Platform on Google Cloud Platform (GCP)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:workers": "npm run dev --workspace=apps/workers",
    "build": "npm run --workspaces --if-present build",
    "test": "npm run --workspaces --if-present test",
    "lint": "npm run --workspaces --if-present lint",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "security:audit": "node scripts/ci-security-check.js",
    "db:generate": "npm run db:generate --workspace=@shopcloud/database",
    "db:migrate": "npm run db:migrate --workspace=@shopcloud/database",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=@shopcloud/database",
    "db:status": "npm run db:status --workspace=@shopcloud/database",
    "db:reset": "npm run db:reset --workspace=@shopcloud/database",
    "db:seed": "npm run db:seed --workspace=@shopcloud/database",
    "test:load:validate": "node tests/load/validate-scripts.js",
    "test:load:smoke": "k6 run --duration 10s tests/load/scenarios/health.js",
    "test:load:catalog": "k6 run --duration 10s tests/load/scenarios/catalog.js",
    "test:load:events": "k6 run --duration 10s tests/load/scenarios/event-processing.js",
    "test:load:suite": "k6 run tests/load/index.js",
    "test:k8s:validate": "node scripts/validate-k8s-manifests.js"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "typescript": "^5.5.4"
  }
}
